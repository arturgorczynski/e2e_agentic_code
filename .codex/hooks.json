{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$(git rev-parse --show-toplevel)/.codex/hooks/git_safety.py\"",
            "commandWindows": "python -I \"$(git rev-parse --show-toplevel)/.codex/hooks/git_safety.py\"",
            "timeout": 10,
            "statusMessage": "Checking Git staging, commits, and destructive operations"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$(git rev-parse --show-toplevel)/.codex/hooks/block_delete.py\"",
            "commandWindows": "python -I \"$(git rev-parse --show-toplevel)/.codex/hooks/block_delete.py\"",
            "timeout": 10,
            "statusMessage": "Checking file deletions"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$(git rev-parse --show-toplevel)/.codex/hooks/block_jokes_write.py\"",
            "commandWindows": "python -I \"$(git rev-parse --show-toplevel)/.codex/hooks/block_jokes_write.py\"",
            "timeout": 10,
            "statusMessage": "Checking joke-file writes"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$(git rev-parse --show-toplevel)/.codex/hooks/notebook_context.py\"",
            "commandWindows": "python -I \"$(git rev-parse --show-toplevel)/.codex/hooks/notebook_context.py\"",
            "timeout": 10,
            "statusMessage": "Adding notebook validation context"
          }
        ]
      }
    ]
  }
}
