# Only the root .env is loaded. Never overwrite an existing .env.
# Select profiles/roles in root models.toml. Fill only providers you use.
OLLAMA_MODEL=gemma4:12b
OLLAMA_BASE_URL=http://localhost:11434

# Optional RAG lessons: local embedding, vision chat and System One decision models.
RAG_EMBED_MODEL=qwen3-embedding:0.6b
RAG_MULTIMODAL_EMBED_MODEL=embeddinggemma-2:latest
RAG_VISION_MODEL=gemma4:12b
RAG_RERANK_MODELS=clef-flash:latest,clef:latest
RAG_RERANK_MODEL=clef-flash:latest

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_MODERATION_MODEL=omni-moderation-latest

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
