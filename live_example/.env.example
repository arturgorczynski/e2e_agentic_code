# Copy to .env in THIS project directory. Never overwrite an existing .env.
# Set an installed, tool-capable Ollama model before constructing a local model.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# Fill only the provider you select in models.toml.
OPENAI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
